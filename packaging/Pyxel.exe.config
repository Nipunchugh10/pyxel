<?xml version="1.0" encoding="utf-8"?>
<!--
  .NET Framework settings for Pyxel.exe (pywebview hosts .NET through pythonnet).

  A zip downloaded through a browser carries Mark-of-the-Web, and Windows copies
  it onto every extracted file. .NET then refuses to load the app's own
  assemblies (Python.Runtime.dll, the WebView2 wrappers) as "remote sources",
  and the app cannot start. This setting lets it load them.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
